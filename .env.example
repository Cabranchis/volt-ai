# Copy to .env and fill in. Never commit .env.

# PostgreSQL (Neon or Supabase). Pipeline writes with this role.
DATABASE_URL=postgresql://user:password@host:5432/voltia

# Read-only role used by the web app (see db/migrations/0002_roles.sql).
DATABASE_URL_READONLY=postgresql://voltia_ro:password@host:5432/voltia

# Optional. Without it the analyst falls back to rule-based answers and the
# daily briefing falls back to a deterministic template.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional local development: use SQLite and JSON fixtures, no database needed.
VOLTIA_LOCAL_DB=pipeline/data/voltia.sqlite
